# فاز تست (تداخلی با nginx فعلی ندارد)
HTTP_PORT=8080
HTTPS_PORT=8443

# در گام ۵ (سوییچ نهایی) این دو خط را جایگزین کنید:
# HTTP_PORT=80
# HTTPS_PORT=443

# رمز داشبورد Traefik — با این دستور بسازید:
#   htpasswd -nb admin 'YOUR_PASSWORD' | sed -e 's/\$/\$\$/g'
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$CHANGEME$$CHANGEMECHANGEME
