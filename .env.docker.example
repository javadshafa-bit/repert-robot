# ============================================================
# تنظیمات repert-robot روی سرور — این فایل را به .env.docker کپی کنید
# ⚠️ .env.docker را هرگز در git کامیت نکنید
# ============================================================

APP_NAME="Repert Robot"
APP_ENV=production
# با دستور زیر بسازید:  docker run --rm repert-robot:latest php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://a1-studio.ir

LOG_CHANNEL=stack
LOG_LEVEL=error

# ---- دیتابیس ----
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=repert
DB_USERNAME=repert
# رمزهای قوی بسازید:  openssl rand -base64 24
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME_TOO

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# نکته: اعتماد به reverse proxy در bootstrap/app.php تنظیم شده
# (trustProxies at '*') — نیازی به متغیر جداگانه نیست.
