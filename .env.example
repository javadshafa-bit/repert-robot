APP_NAME="Repert Robot"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app-url.chabokan.net

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Telegram Bot (if used)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# پیامک — کد یک‌بارمصرف ورود به ربات
# SMS_DRIVER=log  یعنی هیچ پیامکی ارسال نمی‌شود و کد در لاگ می‌نشیند (فقط توسعه)
SMS_DRIVER=log
SMS_TIMEOUT=10
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
